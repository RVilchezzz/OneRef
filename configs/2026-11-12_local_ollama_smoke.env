# 2026-11-12 · local smoke run of the full pipeline on a few dev images (RTX 3060 Laptop, 6 GB)
# Usage: set -a; source configs/2026-11-12_local_ollama_smoke.env; set +a
#        PYTHONPATH=src .venv/bin/python -m inspector.main --split dev --per-source 2 --run-name smoke_ollama_qwen4b
#
# Readers: Qwen3-VL-4B instruct, Q4 quantized, served by Ollama (OpenAI-compatible endpoint).
# Both readers use the same model ("identical readers" ablation): InternVL3-8B and the 8B
# readers are for Colab. Not a baseline, only a check that the whole workflow runs.
ONEREF_LLM_BASE_URL=http://localhost:11434/v1
ONEREF_LLM_API_KEY=ollama
ONEREF_READER_A_MODEL=qwen3-vl:4b-instruct
ONEREF_READER_B_MODEL=qwen3-vl:4b-instruct
ONEREF_CRITIC_MODEL=qwen3-vl:4b-instruct

# Rules-only verifier: no tool calls and one fewer GPU pass.
ONEREF_USE_LLM_CRITIC=false

# Expert calibration (decided on dev, 2026-11-12): a single global threshold on the DINOv3 peak
# distance, 0.165, maximizes balanced accuracy on the dev split (0.49 -> 0.61, in-sample).
# The score is (peak - low) / (high - low) and the flag fires at 0.5, so low/high are centered on 0.165.
ONEREF_ANOMALY_NORM_LOW=0.065
ONEREF_ANOMALY_NORM_HIGH=0.265
