# 2026-11-19 · S at 4B scale on Colab (vLLM, one server per pass). Colab probe config, NOT the frozen test config.
# Same system and expert calibration as configs/2026-11-19_frozen.env (Ollama GGUF); only serving and model ids change.
# Model ids are UNVERIFIED on vLLM/T4 (fp16, no bf16): check on the probe. Load AFTER notebook cell 5 (paths to Drive).
ONEREF_LLM_PROVIDER=vllm
ONEREF_LLM_BASE_URL=http://localhost:8000/v1
ONEREF_LLM_API_KEY=EMPTY
ONEREF_VLLM_AUTOSTART=true
ONEREF_READER_A_MODEL=Qwen/Qwen3-VL-4B-Instruct
ONEREF_READER_B_MODEL=OpenGVLab/InternVL3_5-4B
ONEREF_USE_LLM_CRITIC=true
ONEREF_CRITIC_MODEL=google/gemma-4-E2B-it
ONEREF_JUDGE_MODEL=google/gemma-4-E2B-it
ONEREF_JUDGE_MODE=override
# Gemma thinking OFF; verified on Ollama only. If the reply has a reasoning block under vLLM, use
# '{"chat_template_kwargs": {"enable_thinking": false}}' instead.
ONEREF_CRITIC_EXTRA_BODY='{"reasoning_effort": "none"}'
ONEREF_JUDGE_EXTRA_BODY='{"reasoning_effort": "none"}'
ONEREF_READER_HINT=full

# Expert calibration (dev, 2026-11-12): global threshold 0.165 on the DINOv3 peak distance.
ONEREF_ANOMALY_NORM_LOW=0.065
ONEREF_ANOMALY_NORM_HIGH=0.265
# Expert vote on discrimination (dev, 2026-11-17, variant C2).
ONEREF_EXPERT_WEIGHT_DISCRIMINATION=0.5
ONEREF_EXPERT_WEIGHT_BY_SOURCE='{"GoodsAD": 0}'
ONEREF_EXPERT_THRESHOLD_BY_SOURCE='{"DS-MVTec": 0.7, "MVTec-LOCO": 0.7, "VisA": 0.3}'
