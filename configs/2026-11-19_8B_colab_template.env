# 2026-11-19 · TEMPLATE for the 8B version of S (Colab, vLLM). NOT frozen, NOT run yet.
# Same system as configs/2026-11-19_frozen.env (4B), with the 8B readers. Guide: docs/guides/guide_8B.fr.md.
#
# Rules: run on dev first and decide on dev only; copy this file to configs/<date>_8B_frozen.env before the
# test, then never edit it. Test = the same 2,000 images as the 4B test (data/splits/test_sample2000_ids.json,
# `--sample 2000`), run once with --frozen-config.
#
# Colab: the notebook (Colab/OneRef_Colab.ipynb) loads this file in cell 5 when PROFILE = "8B" (cell 1). GPU L4.

# ---- serving: one vLLM server per pass (only one model on the GPU at a time) ----
ONEREF_LLM_PROVIDER=vllm
ONEREF_LLM_BASE_URL=http://localhost:8000/v1
ONEREF_LLM_API_KEY=EMPTY
ONEREF_VLLM_AUTOSTART=true

# ---- models (8B scale). TO CHECK on Hugging Face and with vLLM before the dev run ----
ONEREF_READER_A_MODEL=Qwen/Qwen3-VL-8B-Instruct
ONEREF_READER_B_MODEL=OpenGVLab/InternVL3_5-8B
# Verifier and judge: a third family, as in the 4B system (Gemma 4 E2B there). The id below is a placeholder:
# pick the Gemma 4 instruct checkpoint that vLLM serves on the Colab GPU (E4B fits an L4 in bf16).
ONEREF_USE_LLM_CRITIC=true
ONEREF_CRITIC_MODEL=google/gemma-4-E4B-it
ONEREF_JUDGE_MODEL=google/gemma-4-E4B-it
ONEREF_JUDGE_MODE=override
# Gemma thinking OFF, vLLM form (not yet verified on Colab): notebook cell 6b prints one reply per model,
# it must contain no reasoning block.
ONEREF_CRITIC_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
ONEREF_JUDGE_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# The rule findings are in the critic's prompt; offering the tool next to JSON output broke the review at 4B.
ONEREF_CRITIC_USE_TOOL=false

# ---- reader hint, as in the 4B frozen config ----
ONEREF_READER_HINT=full

# ---- expert: DINOv2 (access to the gated DINOv3 was refused, Nov 25) ----
ONEREF_EXPERT_MODEL=facebook/dinov2-base
# Recalibrated on dev (835 images, results/expert_eval/dev_dinov2-base_v1): global peak threshold 0.455,
# balanced accuracy 0.622 (in-sample, optimistic); low/high = threshold -/+ 0.1, as for DINOv3.
ONEREF_ANOMALY_NORM_LOW=0.355
ONEREF_ANOMALY_NORM_HIGH=0.555
# Vote weights and per-source thresholds below were fitted with DINOv3: re-fit them after the dev run with
# scripts/sweep_discrimination.py (no GPU).
ONEREF_EXPERT_WEIGHT_DISCRIMINATION=0.5
ONEREF_EXPERT_WEIGHT_BY_SOURCE='{"GoodsAD": 0}'
ONEREF_EXPERT_THRESHOLD_BY_SOURCE='{"DS-MVTec": 0.7, "MVTec-LOCO": 0.7, "VisA": 0.3}'
