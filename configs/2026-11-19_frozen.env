# 2026-11-19 · FROZEN configuration of the full system S (4B scale, local). Do not edit after the test run.
# Decided on dev only (835 images, 3,937 questions), see results/compare/2026-11-17_dev_full_S/.
# Team decision (Nov 18): the project stays at the 4B scale; the 8B models are dropped (no Colab).
#
# Usage (RTX 3060 Laptop 6 GB, Ollama):
#   OLLAMA_CONTEXT_LENGTH=8192 ollama serve
#   set -a; source configs/2026-11-19_frozen.env; set +a
#   PYTHONPATH=src .venv/bin/python -m inspector.main --split test --sample 2000 --frozen-config --run-name test_S
#
# Choices and their dev evidence (mean of 7 subtasks; B1 = Qwen3-VL-4B alone = 65.9):
# - Readers: A = Qwen3-VL-4B, B = InternVL3.5-4B (two families). Expert hint ON for every source
#   (+6.8 points on 82 dev images, 2026-11-16_hint).
# - Verifier: Gemma 4 E2B with its consistency rules, one reopen max (64.4 vs 64.2 without, p = 0.26;
#   kept because it is part of S as planned; its effect is reported as an ablation).
# - Conflict judge: Gemma 4 E2B, mode "override", only on questions where the voters disagree
#   (66.5 vs 64.4 without the judge, McNemar p = 0.004; vs B1: +0.6, p = 0.28).
# - Expert vote on discrimination (calibration C2): weight 0.5, off on GoodsAD (expert AUROC 0.51 on dev),
#   per-source thresholds from the dev sweep. With the judge it gives the same answers as the default
#   on dev; kept because it lowers the FPR when the judge does not answer.
# - Gemma thinking OFF (reasoning_effort none): otherwise it spends max_new_tokens reasoning, returns nothing.
ONEREF_LLM_BASE_URL=http://localhost:11434/v1
ONEREF_LLM_API_KEY=ollama
ONEREF_READER_A_MODEL=qwen3-vl:4b-instruct
ONEREF_READER_B_MODEL=hf.co/bartowski/OpenGVLab_InternVL3_5-4B-GGUF:Q4_K_M
ONEREF_USE_LLM_CRITIC=true
ONEREF_CRITIC_MODEL=gemma4:e2b
ONEREF_CRITIC_EXTRA_BODY='{"reasoning_effort": "none"}'
ONEREF_JUDGE_MODEL=gemma4:e2b
ONEREF_JUDGE_MODE=override
ONEREF_JUDGE_EXTRA_BODY='{"reasoning_effort": "none"}'
ONEREF_READER_HINT=full

# Expert calibration (dev, 2026-11-12): global threshold 0.165 on the DINOv3 peak distance.
ONEREF_ANOMALY_NORM_LOW=0.065
ONEREF_ANOMALY_NORM_HIGH=0.265
# Expert vote on discrimination (dev, 2026-11-17, variant C2).
ONEREF_EXPERT_WEIGHT_DISCRIMINATION=0.5
ONEREF_EXPERT_WEIGHT_BY_SOURCE='{"GoodsAD": 0}'
ONEREF_EXPERT_THRESHOLD_BY_SOURCE='{"DS-MVTec": 0.7, "MVTec-LOCO": 0.7, "VisA": 0.3}'
