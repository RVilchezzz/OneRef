# 2026-11-25 · B1 "Qwen alone": Qwen3-VL-4B without any expert evidence (no hint text, no crop, no expert vote).
# Load AFTER configs/2026-11-17_small_models.env. Run with --steps expert,reader_a,aggregator (the expert pass is
# only reused from S's cache; its output never reaches the reader or the vote).
ONEREF_READER_HINT=none
ONEREF_AGGREGATE_READERS='["reader_a"]'
ONEREF_EXPERT_WEIGHT_DISCRIMINATION=0
ONEREF_JUDGE_MODE=off
